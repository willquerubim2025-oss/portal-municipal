---
// Layout de todas as páginas do portal: acessibilidade (eMAG), SEO (D-15) e
// identidade visual do município (municipios.tema / config). Nada de prefeitura
// específica aqui (D-10).
import '../styles/global.css';
// Tema ampliado (D-17, D-39): fontes auto-hospedadas (só o subconjunto latino) e estilos do
// layout vitrine. Os @font-face só baixam a fonte se uma página usá-la.
import '@fontsource/montserrat/latin-600.css';
import '@fontsource/montserrat/latin-700.css';
import '@fontsource/montserrat/latin-800.css';
import '@fontsource/source-sans-3/latin-400.css';
import '@fontsource/source-sans-3/latin-400-italic.css';
import '@fontsource/source-sans-3/latin-600.css';
import '@fontsource/source-sans-3/latin-700.css';
import '@fontsource/prompt/latin-400.css';
import '@fontsource/prompt/latin-500.css';
import '@fontsource/prompt/latin-600.css';
import '@fontsource/prompt/latin-700.css';
import '../styles/vitrine.css';
import { destaques, menu, type ItemMenu } from '../lib/consultas';
import Ferramentas from '../components/Ferramentas.astro';
import { FONTES_DISPONIVEIS, moduloAtivo, nomeCurto } from '../lib/municipio';
import { urlMidia } from '../lib/supabase';
import MenuItens from '../components/MenuItens.astro';
import Avisos from '../components/vitrine/Avisos.astro';

export interface Migalha { nome: string; href?: string }
interface Props {
  titulo?: string;             // ausente = página inicial
  descricao?: string;
  imagem?: string | null;      // URL absoluta para Open Graph
  tipoOg?: 'website' | 'article';
  jsonLd?: object | object[];
  migalhas?: Migalha[];        // breadcrumb (sem "Início", que é automático)
  noindex?: boolean;
}

const { titulo, descricao, imagem, tipoOg = 'website', jsonLd, migalhas = [], noindex = false } = Astro.props;
const { municipio: m, dominioPrincipal, homologacao } = Astro.locals.contexto;
const cfg = m.config;
const tema = m.tema;
const origem = `https://${dominioPrincipal}`;

// Canônico: domínio principal + caminho + só os parâmetros que mudam o conteúdo.
const params = new URLSearchParams();
for (const p of ['categoria', 'ano', 'pagina', 'situacao']) {
  const v = Astro.url.searchParams.get(p);
  if (v && !(p === 'pagina' && v === '1')) params.set(p, v);
}
const canonico = `${origem}${Astro.url.pathname === '/' ? '' : Astro.url.pathname}${params.size ? `?${params}` : ''}`;
const tituloCompleto = titulo ? `${titulo} — ${m.nome}` : m.nome;
const desc = descricao || cfg.slogan || `Portal oficial da ${m.nome}: notícias, serviços, legislação e transparência.`;
const brasao = urlMidia(tema.brasao_path) ?? (tema.brasao_url?.startsWith('https://') ? tema.brasao_url : null);
const vitrine = tema.layout === 'vitrine';
const imagemOg = imagem ?? urlMidia(cfg.seo?.imagem_compartilhamento_path) ?? brasao;

const [principal, rodape, alertas] = await Promise.all([
  menu(m.id, 'principal'),
  menu(m.id, 'rodape'),
  moduloAtivo(m, 'destaques') ? destaques(m.id).then((d) => d.filter((x) => x.tipo === 'alerta')) : Promise.resolve([]),
]);

// Sem menu cadastrado, o portal monta um menu padrão a partir dos módulos ligados.
const menuPadrao: ItemMenu[] = [
  { rotulo: 'Início', href: '/', novaAba: false, filhos: [] },
  { rotulo: 'Notícias', href: '/noticias', novaAba: false, filhos: [] },
  moduloAtivo(m, 'carta_servicos') && { rotulo: 'Serviços', href: '/servicos', novaAba: false, filhos: [] },
  moduloAtivo(m, 'legislacao') && { rotulo: 'Legislação', href: '/legislacao', novaAba: false, filhos: [] },
  { rotulo: 'Documentos', href: '/documentos', novaAba: false, filhos: [] },
  { rotulo: 'Transparência', href: '/transparencia', novaAba: false, filhos: [] },
  moduloAtivo(m, 'agenda') && { rotulo: 'Agenda', href: '/eventos', novaAba: false, filhos: [] },
  moduloAtivo(m, 'estrutura_organizacional') && { rotulo: 'Estrutura', href: '/estrutura-organizacional', novaAba: false, filhos: [] },
].filter(Boolean) as ItemMenu[];
const itensMenu = principal.length ? principal : menuPadrao;

const linksObrigatorios = [
  { rotulo: 'Acesso à Informação', href: '/acesso-a-informacao' },
  { rotulo: 'Ouvidoria', href: '/ouvidoria' },
  { rotulo: 'Transparência', href: '/transparencia' },
  { rotulo: 'Privacidade', href: '/privacidade' },
  { rotulo: 'Acessibilidade', href: '/acessibilidade' },
];

// Dados estruturados: o município em toda página + o que a página informar.
const orgLd = {
  '@context': 'https://schema.org',
  '@type': 'GovernmentOrganization',
  '@id': `${origem}/#organizacao`,
  name: m.nome,
  url: origem,
  ...(brasao && { logo: brasao }),
  ...(cfg.telefone && { telephone: cfg.telefone }),
  ...(cfg.email && { email: cfg.email }),
  ...(cfg.endereco && { address: { '@type': 'PostalAddress', streetAddress: cfg.endereco, addressRegion: m.uf, addressCountry: 'BR' } }),
  ...(cfg.redes && { sameAs: Object.values(cfg.redes) }),
};
const migalhaLd = migalhas.length ? {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [{ nome: 'Início', href: '/' }, ...migalhas].map((x, i) => ({
    '@type': 'ListItem', position: i + 1, name: x.nome, ...(x.href && { item: `${origem}${x.href}` }),
  })),
} : null;
const ld = [orgLd, ...(Array.isArray(jsonLd) ? jsonLd : jsonLd ? [jsonLd] : []), ...(migalhaLd ? [migalhaLd] : [])];
// Escapa o sinal de menor (<) para o JSON não fechar a tag do JSON-LD antes da hora.
// (Não escrever o nome da tag neste comentário: o scanner do Vite o confunde com uma tag real.)
const ldJson = JSON.stringify(ld).replaceAll(String.fromCharCode(60), '\\u003c');

// Só valores de cor e nomes de fonte conhecidos entram no style (o tema vem do banco).
const cor = (v?: string) => (v && /^#[0-9a-f]{3,8}$/i.test(v) ? v : undefined);
const medida = (v?: string) => (v && /^\d{1,2}(\.\d)?(cm|rem)$|^\d{1,3}px$/.test(v) ? v : undefined);
const fonte = (f?: string) => (f && (FONTES_DISPONIVEIS as readonly string[]).includes(f) ? `"${f}"` : undefined);
const estiloTema = [
  cor(tema.cor_primaria) && `--cor-primaria:${tema.cor_primaria}`,
  cor(tema.cor_secundaria) && `--cor-secundaria:${tema.cor_secundaria}`,
  ...(vitrine ? [
    cor(tema.cor_secundaria_escura) && `--v-secundaria-escura:${tema.cor_secundaria_escura}`,
    cor(tema.cor_acento) && `--v-acento:${tema.cor_acento}`,
    cor(tema.cor_regua) && `--v-regua:${tema.cor_regua}`,
    fonte(tema.fonte_titulos) && `--v-fonte-titulos:${fonte(tema.fonte_titulos)}`,
    fonte(tema.fonte_texto) && `--v-fonte-texto:${fonte(tema.fonte_texto)}`,
    medida(tema.margem_destaque) && `--v-margem-destaque:${tema.margem_destaque}`,
    medida(tema.margem_secoes) && `--v-margem-secoes:${tema.margem_secoes}`,
    ...(tema.cores_vivas ?? []).flatMap((c, i) => [
      cor(c.forte) && `--v-cor-${i}:${c.forte}`,
      cor(c.claro) && `--v-tom-${i}:${c.claro}`,
    ]),
  ] : []),
].filter(Boolean).join(';');
const marca1 = cfg.marca?.linha1 ?? 'Prefeitura de';
const marca2 = cfg.marca?.linha2 ?? nomeCurto(m);
const sitePrefeitura = vitrine && cfg.site_prefeitura?.startsWith('https://') ? cfg.site_prefeitura : null;
const caminhoAtual = Astro.url.pathname;
---
<!doctype html>
<html lang="pt-BR" class={vitrine ? 'vitrine' : undefined} style={estiloTema || undefined}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{tituloCompleto}</title>
  <meta name="description" content={desc} />
  <link rel="canonical" href={canonico} />
  {(noindex || homologacao) && <meta name="robots" content="noindex, nofollow" />}
  {cfg.seo?.google_site_verification && <meta name="google-site-verification" content={cfg.seo.google_site_verification} />}
  {brasao && <link rel="icon" href={brasao} />}
  <meta name="theme-color" content={tema.cor_primaria ?? '#0b4f8a'} />

  <meta property="og:site_name" content={m.nome} />
  <meta property="og:locale" content="pt_BR" />
  <meta property="og:type" content={tipoOg} />
  <meta property="og:title" content={titulo ?? m.nome} />
  <meta property="og:description" content={desc} />
  <meta property="og:url" content={canonico} />
  {imagemOg && <meta property="og:image" content={imagemOg} />}
  <meta name="twitter:card" content={imagemOg ? 'summary_large_image' : 'summary'} />

  <link rel="alternate" type="application/xml" title="Mapa do site" href="/sitemap.xml" />
  <script type="application/ld+json" set:html={ldJson} />
  <!-- Alto contraste e tamanho do texto antes da pintura, para não piscar. -->
  <script is:inline>
    try {
      document.documentElement.classList.add('js');
      if (localStorage.getItem('contraste') === '1') document.documentElement.classList.add('contraste');
      var n = Number(localStorage.getItem('fonte') || 0);
      if (n > 0 && n <= 4) document.documentElement.style.fontSize = (100 + 12.5 * n) + '%';
    } catch {}
  </script>
</head>
<body>
  {homologacao && <div class="faixa-homologacao" role="note">Ambiente de homologação — conteúdo de teste, não indexado.</div>}

  <!-- Barra de acessibilidade (eMAG 3.1): atalhos numéricos e alto contraste.
       No layout vitrine a barra vira cabeçalho único: os atalhos ficam ocultos até receberem foco
       (Tab ou accesskey) e as ferramentas sobem para a linha da marca. -->
  <div class={vitrine ? 'barra-acessibilidade v-pular' : 'barra-acessibilidade'}>
    <div class="container">
      <ul class="atalhos" aria-label="Atalhos de teclado">
        <li><a href="#conteudo" accesskey="1">Ir para o conteúdo <span>1</span></a></li>
        <li><a href="#menu" accesskey="2">Ir para o menu <span>2</span></a></li>
        <li><a href="#busca" accesskey="3">Ir para a busca <span>3</span></a></li>
        <li><a href="#rodape" accesskey="4">Ir para o rodapé <span>4</span></a></li>
      </ul>
      {!vitrine && <Ferramentas />}
    </div>
  </div>


  <!-- Layout vitrine (D-42): cabeçalho em linha única no verde da Prefeitura: marca, menu, busca e acessibilidade.
       Busca e acessibilidade abrem painéis; sem JavaScript os painéis ficam sempre visíveis. -->
  {vitrine ? (
  <header class="cabecalho v-cab">
      <div class="v-cab-linha">
        <a href="/" class="marca" aria-label={`${m.nome} — página inicial`}>
          {brasao && <span class="v-cab-brasao"><img src={brasao} alt="" width="64" height="64" /></span>}
          <span class="marca-texto">
            <span class="marca-tipo">{marca1}</span>
            <span class="marca-nome">{marca2}</span>
          </span>
        </a>
        <nav id="menu" class="menu-principal" aria-label="Menu principal">
          <details class="menu-movel" open>
            <summary>Menu</summary>
            <MenuItens itens={itensMenu} atual={caminhoAtual} />
          </details>
        </nav>
        <div class="v-cab-acoes">
          <button type="button" class="v-cab-botao" data-painel="v-painel-busca" aria-expanded="false" aria-controls="v-painel-busca" aria-label="Abrir a busca" title="Buscar"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="M20 20l-4-4"/></svg></button>
          <button type="button" class="v-cab-botao" data-painel="v-painel-acessibilidade" aria-expanded="false" aria-controls="v-painel-acessibilidade" aria-label="Recursos de acessibilidade" title="Acessibilidade">
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="11" fill="none" stroke="currentColor" stroke-width="1.6"/><circle cx="12" cy="6.2" r="1.6" fill="currentColor"/><path d="M6.5 9.2l5.5 1 5.5-1M12 10.2v4.2m0 0l-2.6 4.6m2.6-4.6l2.6 4.6" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
        </div>
      </div>
      <div class="v-cab-painel" id="v-painel-busca">
        <form class="busca" action="/busca" method="get" role="search">
          <label for="busca" class="sr-only">Buscar no portal</label>
          <input id="busca" name="q" type="search" placeholder="O que você procura?" required />
          <button type="submit">Buscar</button>
        </form>
      </div>
      <div class="v-cab-painel" id="v-painel-acessibilidade">
        <Ferramentas compacto />
        {sitePrefeitura && (
          <a class="v-link-prefeitura" href={sitePrefeitura}>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5M11 6l-6 6 6 6"/></svg>
            <span>Site da Prefeitura</span>
          </a>
        )}
      </div>
    </header>
  ) : (
  <header class="cabecalho">
      <div class="container cabecalho-linha">
        <a href="/" class="marca" aria-label={`${m.nome} — página inicial`}>
          {brasao && <img src={brasao} alt="" width="64" height="64" />}
          <span class="marca-texto">
            <span class="marca-tipo">{marca1}</span>
            <span class="marca-nome">{marca2}</span>
          </span>
        </a>
        <form class="busca" action="/busca" method="get" role="search">
          <label for="busca" class="sr-only">Buscar no portal</label>
          <input id="busca" name="q" type="search" placeholder="O que você procura?" required />
          <button type="submit">Buscar</button>
        </form>
      </div>
      <nav id="menu" class="menu-principal" aria-label="Menu principal">
        <details class="container menu-movel" open>
          <summary>Menu</summary>
          <MenuItens itens={itensMenu} atual={caminhoAtual} />
        </details>
      </nav>
    </header>
  )}

  {vitrine && <Avisos avisos={alertas} />}
  {!vitrine && alertas.length > 0 && (
    <section class="alertas" aria-label="Alertas">
      {alertas.map((a) => (
        <div class={`alerta alerta-${a.nivel}`} role={a.nivel === 'urgente' ? 'alert' : undefined}>
          <div class="container">
            <strong>{a.titulo}</strong>{a.texto && <> — {a.texto}</>}
            {a.url && <> <a href={a.url} target={a.nova_aba ? '_blank' : undefined} rel={a.nova_aba ? 'noopener' : undefined}>Saiba mais</a></>}
          </div>
        </div>
      ))}
    </section>
  )}

  {migalhas.length > 0 && (
    <nav class="container migalhas" aria-label="Você está em">
      <ol>
        <li><a href="/">Início</a></li>
        {migalhas.map((x, i) => (
          <li>{x.href && i < migalhas.length - 1 ? <a href={x.href}>{x.nome}</a> : <span aria-current="page">{x.nome}</span>}</li>
        ))}
      </ol>
    </nav>
  )}

  <main id="conteudo" tabindex="-1">
    <slot />
  </main>

  <footer id="rodape" class="rodape">
    <div class="container rodape-grade">
      <section>
        <h2>{m.nome}</h2>
        <address>
          {cfg.endereco && <p>{cfg.endereco}</p>}
          {cfg.telefone && <p>Telefone: <a href={`tel:${cfg.telefone.replace(/\D/g, '')}`}>{cfg.telefone}</a></p>}
          {cfg.email && <p>E-mail: <a href={`mailto:${cfg.email}`}>{cfg.email}</a></p>}
          {cfg.horario && <p>Atendimento: {cfg.horario}</p>}
          {(m.cnpj ?? cfg.cnpj) && <p>CNPJ: {m.cnpj ?? cfg.cnpj}</p>}
        </address>
      </section>
      <nav aria-label="Links institucionais">
        <h2>Institucional</h2>
        <ul>{linksObrigatorios.map((l) => <li><a href={l.href}>{l.rotulo}</a></li>)}</ul>
      </nav>
      {rodape.length > 0 && (
        <nav aria-label="Links do rodapé">
          <h2>Links úteis</h2>
          <MenuItens itens={rodape} atual={caminhoAtual} />
        </nav>
      )}
      {cfg.redes && Object.keys(cfg.redes).length > 0 && (
        <nav aria-label="Redes sociais">
          <h2>Redes sociais</h2>
          <ul>{Object.entries(cfg.redes).map(([rede, url]) => <li><a href={url} rel="noopener" target="_blank">{rede.charAt(0).toUpperCase() + rede.slice(1)}<span class="sr-only"> (abre em nova aba)</span></a></li>)}</ul>
        </nav>
      )}
    </div>
    <div class="rodape-base">
      <div class="container rodape-base-linha">
        <a href="/mapa-do-site">Mapa do site</a>
        {cfg.radar_transparencia !== false && (
          <a class="radar-transparencia" href="https://radardatransparencia.atricon.org.br/" rel="noopener" target="_blank">
            Radar da Transparência Pública<span class="sr-only"> (abre em nova aba)</span>
          </a>
        )}
      </div>
    </div>
  </footer>

  <script>
    const botao = document.getElementById('botao-contraste');
    const raiz = document.documentElement;
    const sincronizar = () => botao?.setAttribute('aria-pressed', String(raiz.classList.contains('contraste')));
    sincronizar();
    botao?.addEventListener('click', () => {
      raiz.classList.toggle('contraste');
      try { localStorage.setItem('contraste', raiz.classList.contains('contraste') ? '1' : '0'); } catch {}
      sincronizar();
    });
    // Tamanho do texto (eMAG, PNTP 13.4): 5 passos de 12,5%, guardado no navegador.
    let fonte = 0;
    try { fonte = Math.min(4, Math.max(0, Number(localStorage.getItem('fonte') || 0))); } catch {}
    document.querySelectorAll<HTMLButtonElement>('[data-fonte]').forEach((b) => b.addEventListener('click', () => {
      const passo = Number(b.dataset.fonte);
      fonte = passo === 0 ? 0 : Math.min(4, Math.max(0, fonte + passo));
      raiz.style.fontSize = fonte ? `${100 + 12.5 * fonte}%` : '';
      try { localStorage.setItem('fonte', String(fonte)); } catch {}
    }));
    // No celular o menu começa fechado; no desktop fica sempre aberto.
    const menuMovel = document.querySelector<HTMLDetailsElement>('.menu-movel');
    const mq = matchMedia(raiz.classList.contains('vitrine') ? '(max-width: 1180px)' : '(max-width: 800px)');
    const ajustar = () => { if (menuMovel) menuMovel.open = !mq.matches; };
    ajustar();
    mq.addEventListener('change', ajustar);
    // Painéis do cabeçalho vitrine (busca e acessibilidade): um aberto por vez; Esc fecha e devolve o foco.
    const botoesPainel = [...document.querySelectorAll<HTMLButtonElement>('[data-painel]')];
    const abrirPainel = (b: HTMLButtonElement, abrir: boolean) => {
      botoesPainel.forEach((o) => { o.setAttribute('aria-expanded', String(o === b && abrir)); document.getElementById(o.dataset.painel!)?.classList.toggle('aberto', o === b && abrir); });
      if (abrir) document.getElementById(b.dataset.painel!)?.querySelector<HTMLElement>('input, button, a')?.focus();
    };
    botoesPainel.forEach((b) => {
      b.addEventListener('click', () => abrirPainel(b, b.getAttribute('aria-expanded') !== 'true'));
      document.getElementById(b.dataset.painel!)?.addEventListener('keydown', (e) => { if (e.key === 'Escape') { abrirPainel(b, false); b.focus(); } });
    });
    // O atalho "Ir para a busca" (accesskey 3) abre o painel da busca.
    document.querySelectorAll<HTMLAnchorElement>('a[href="#busca"]').forEach((a) => a.addEventListener('click', (e) => {
      const b = botoesPainel.find((o) => o.dataset.painel === 'v-painel-busca');
      if (b) { e.preventDefault(); abrirPainel(b, true); }
    }));
    // Grupos do menu (item com submenu e sem link próprio): abrem com clique, Enter ou espaço; Esc fecha.
    document.querySelectorAll<HTMLButtonElement>('[data-submenu]').forEach((b) => {
      const fechar = () => b.setAttribute('aria-expanded', 'false');
      b.addEventListener('click', () => b.setAttribute('aria-expanded', String(b.getAttribute('aria-expanded') !== 'true')));
      b.parentElement?.addEventListener('keydown', (e) => { if (e.key === 'Escape') { fechar(); b.focus(); } });
      b.parentElement?.addEventListener('focusout', (e) => { if (!b.parentElement!.contains(e.relatedTarget as Node)) fechar(); });
    });
  </script>
</body>
</html>
