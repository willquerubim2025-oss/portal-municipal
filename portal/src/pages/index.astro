---
import Base from '../layouts/Base.astro';
import CartaoNoticia from '../components/CartaoNoticia.astro';
import { destaques, eventos, menu, noticias } from '../lib/consultas';
import { moduloAtivo } from '../lib/municipio';
import { urlImagem, srcsetImagem } from '../lib/imagens';
import { diaMes, hora } from '../lib/formato';
import { equipe, eventosCalendario, servicosHome } from '../lib/consultas';
import Destaque from '../components/vitrine/Destaque.astro';
import NoticiasVitrine from '../components/vitrine/Noticias.astro';
import ServicosVitrine from '../components/vitrine/Servicos.astro';
import EquipeVitrine from '../components/vitrine/Equipe.astro';
import FocoVitrine from '../components/vitrine/Foco.astro';
import CalendarioVitrine from '../components/vitrine/Calendario.astro';
import type { BlocoHome } from '../lib/municipio';

const { municipio: m, dominioPrincipal } = Astro.locals.contexto;
// Layout vitrine (D-39): a página inicial é montada pelos blocos de config.home, nessa ordem.
const blocos: BlocoHome[] = m.tema.layout === 'vitrine' ? (m.config.home?.blocos ?? []) : [];
const tem = (b: BlocoHome) => blocos.includes(b);
// Calendário de eventos (D-53): do 1º dia do mês anterior ao fim do 3º mês seguinte.
const agoraSP = new Date();
const desdeCal = new Date(Date.UTC(agoraSP.getUTCFullYear(), agoraSP.getUTCMonth() - 1, 1));
const ateCal = new Date(Date.UTC(agoraSP.getUTCFullYear(), agoraSP.getUTCMonth() + 4, 1));
const [banners, ultimas, proximos, atalhosMenu, cards, pessoas, eventosCal] = await Promise.all([
  moduloAtivo(m, 'destaques') ? destaques(m.id).then((d) => d.filter((x) => x.tipo === 'banner' && x.imagem)) : Promise.resolve([]),
  noticias(m.id, { limite: 7 }),
  moduloAtivo(m, 'agenda') ? eventos(m.id, { limite: 4 }) : Promise.resolve(null),
  menu(m.id, 'atalhos'),
  tem('servicos') ? servicosHome(m.id) : Promise.resolve([]),
  tem('equipe') && moduloAtivo(m, 'equipe_gestora') ? equipe(m.id) : Promise.resolve([]),
  tem('calendario') && moduloAtivo(m, 'agenda') ? eventosCalendario(m.id, desdeCal, ateCal) : Promise.resolve([]),
]);
const foco = (m.config.home?.foco ?? []).filter((f) => f?.titulo);
const titulos = { noticias: 'Notícias', foco: 'Em foco', calendario: 'Eventos', servicos: 'Serviços', agenda: 'Agenda', equipe: 'Equipe gestora', atalhos: 'Acesso rápido', ...(m.config.home?.titulos ?? {}) };
const nCores = m.tema.cores_vivas?.length ?? 0;
// Seções de largura total alternam branco e os tons claros das cores vivas.
const vazio = (b: BlocoHome) =>
  (b === 'servicos' && cards.length === 0) || (b === 'equipe' && pessoas.length === 0) ||
  (b === 'agenda' && !proximos?.itens.length) || (b === 'foco' && foco.length === 0) || (b === 'calendario' && !moduloAtivo(m, 'agenda')) || b === 'destaque';
// "Em foco" e o calendário têm fundo próprio e ficam fora da alternância.
const secoes = blocos.filter((b) => !vazio(b) && b !== 'foco' && b !== 'calendario');
const fundo = (b: BlocoHome) => {
  if (b === 'foco') return 'v-fundo-foco';
  if (b === 'calendario') return 'v-fundo-cinza';
  const i = secoes.indexOf(b);
  return i % 2 === 0 ? 'v-fundo-branco' : `v-fundo-tom v-tom-${nCores ? Math.floor(i / 2) % nCores : 0}`;
};

// Acesso rápido: menu "atalhos" do município; sem ele, os serviços mais procurados em qualquer prefeitura.
const atalhos = atalhosMenu.length
  ? atalhosMenu.filter((a) => a.href).map((a) => ({ rotulo: a.rotulo, href: a.href!, novaAba: a.novaAba }))
  : [
      moduloAtivo(m, 'carta_servicos') && { rotulo: 'Carta de Serviços', href: '/servicos' },
      { rotulo: 'Transparência', href: '/transparencia' },
      moduloAtivo(m, 'legislacao') && { rotulo: 'Legislação', href: '/legislacao' },
      { rotulo: 'Licitações', href: '/documentos?categoria=licitacoes' },
      { rotulo: 'Concursos', href: '/documentos?categoria=concursos-publicos' },
      { rotulo: 'Ouvidoria', href: '/ouvidoria' },
      { rotulo: 'e-SIC', href: '/e-sic' },
      moduloAtivo(m, 'perguntas_frequentes') && { rotulo: 'Perguntas frequentes', href: '/perguntas-frequentes' },
    ].filter(Boolean).map((a: any) => ({ ...a, novaAba: false }));

const [principal, ...demais] = ultimas.itens;
const siteLd = { '@context': 'https://schema.org', '@type': 'WebSite', name: m.nome, url: `https://${dominioPrincipal}` };
---
<Base jsonLd={siteLd}>
  <h1 class="sr-only">{m.nome}</h1>
  {blocos.length > 0 ? (
    <>
      {blocos.map((b) => {
        if (b === 'destaque') return <Destaque banners={banners} titulo={m.nome} slogan={m.config.slogan} />;
        if (vazio(b)) return null;
        return (
          <section class={`v-secao ${fundo(b)}`} aria-labelledby={`titulo-${b}`}>
            <div class="v-miolo">
              {b === 'noticias' && <NoticiasVitrine noticias={ultimas.itens} titulo={titulos.noticias} />}
              {b === 'foco' && <FocoVitrine itens={foco} titulo={titulos.foco} cores={nCores} />}
              {b === 'calendario' && <CalendarioVitrine eventos={eventosCal} titulo={titulos.calendario} />}
              {b === 'servicos' && <ServicosVitrine servicos={cards} titulo={titulos.servicos} cores={nCores} paleta={m.tema.cores_cards} />}
              {b === 'equipe' && <EquipeVitrine pessoas={pessoas} titulo={titulos.equipe} />}
              {b === 'agenda' && proximos && (
                <>
                  <div class="v-secao-titulo"><h2 id="titulo-agenda">{titulos.agenda}</h2></div>
                  <ul class="v-agenda">
                    {proximos.itens.map((e) => {
                      const d = diaMes(e.inicio_em);
                      return (
                        <li>
                          <span class="v-agenda-data" aria-hidden="true"><strong>{d.dia}</strong>{d.mes}</span>
                          <div>
                            <h3><a href={`/eventos/${e.slug}`}>{e.titulo}</a></h3>
                            <p class="meta"><time datetime={e.inicio_em}>{new Date(e.inicio_em).toLocaleDateString('pt-BR', { timeZone: 'America/Sao_Paulo' })}{!e.dia_inteiro && `, ${hora(e.inicio_em)}`}</time>{e.local && ` · ${e.local}`}</p>
                          </div>
                        </li>
                      );
                    })}
                  </ul>
                  <p class="v-ver-todas"><a href="/eventos">Ver a agenda completa</a></p>
                </>
              )}
              {b === 'atalhos' && (
                <>
                  <div class="v-secao-titulo"><h2 id="titulo-atalhos">{titulos.atalhos}</h2></div>
                  <ul class="v-atalhos">{atalhos.map((a) => <li><a href={a.href} target={a.novaAba ? '_blank' : undefined} rel={a.novaAba ? 'noopener' : undefined}>{a.rotulo}</a></li>)}</ul>
                </>
              )}
            </div>
          </section>
        );
      })}
    </>
  ) : (
  <div class="container">
    {banners.length > 0 && (
      <section aria-label="Destaques" class="home-destaques">
        {banners.slice(0, 2).map((b) => (
          <a class="banner" href={b.url ?? '#'} target={b.nova_aba ? '_blank' : undefined} rel={b.nova_aba ? 'noopener' : undefined}>
            <img src={urlImagem(b.imagem.storage_path, 1200)} srcset={srcsetImagem(b.imagem.storage_path, [640, 800, 1200, 1600])} sizes="(max-width: 1200px) 100vw, 1200px" alt={b.imagem.texto_alternativo ?? b.titulo} width="1200" height="514" />
            <span>{b.titulo}</span>
          </a>
        ))}
      </section>
    )}

    <section aria-labelledby="titulo-atalhos">
      <h2 id="titulo-atalhos">Acesso rápido</h2>
      <ul class="atalhos-home">
        {atalhos.map((a) => (
          <li><a href={a.href} target={a.novaAba ? '_blank' : undefined} rel={a.novaAba ? 'noopener' : undefined}>{a.rotulo}</a></li>
        ))}
      </ul>
    </section>

    <section aria-labelledby="titulo-noticias">
      <div class="secao-titulo">
        <h2 id="titulo-noticias">Notícias</h2>
        <a href="/noticias">Todas as notícias</a>
      </div>
      {ultimas.itens.length === 0
        ? <p>Nenhuma notícia publicada ainda.</p>
        : <div class="grade">
            {principal && <CartaoNoticia noticia={principal} />}
            {demais.map((n) => <CartaoNoticia noticia={n} />)}
          </div>}
    </section>

    {proximos && proximos.itens.length > 0 && (
      <section aria-labelledby="titulo-agenda">
        <div class="secao-titulo">
          <h2 id="titulo-agenda">Agenda</h2>
          <a href="/eventos">Agenda completa</a>
        </div>
        <ul class="lista-simples">
          {proximos.itens.map((e) => {
            const d = diaMes(e.inicio_em);
            return (
              <li class="evento">
                <div class="evento-data" aria-hidden="true"><strong>{d.dia}</strong><span>{d.mes}</span></div>
                <div>
                  <h3><a href={`/eventos/${e.slug}`}>{e.titulo}</a></h3>
                  <p class="meta">
                    <time datetime={e.inicio_em}>{new Date(e.inicio_em).toLocaleDateString('pt-BR', { timeZone: 'America/Sao_Paulo' })}{!e.dia_inteiro && `, ${hora(e.inicio_em)}`}</time>
                    {e.local && ` · ${e.local}`}
                  </p>
                </div>
              </li>
            );
          })}
        </ul>
      </section>
    )}
  </div>
  )}
</Base>
