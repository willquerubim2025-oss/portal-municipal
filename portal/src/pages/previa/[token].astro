---
// Pré-visualização de rascunho (D-91): o painel gera um link /previa/<token> válido por 30 minutos
// (criar_previa, 0023). A página mostra o conteúdo como ficará no site, com um aviso no topo.
// Nunca vai para cache (navegador ou borda) nem para buscadores.
import Base from '../../layouts/Base.astro';
import NoticiaArtigo from '../../components/NoticiaArtigo.astro';
import { previaPublicacao } from '../../lib/consultas';

const { municipio: m } = Astro.locals.contexto;
const n = await previaPublicacao(m.id, Astro.params.token!);
Astro.response.headers.set('Cache-Control', 'private, no-store');
Astro.response.headers.set('Cloudflare-CDN-Cache-Control', 'no-store');
Astro.response.headers.set('X-Robots-Tag', 'noindex, nofollow');
if (!n) Astro.response.status = 404;
const situacao: Record<string, string> = { rascunho: 'rascunho', publicado: 'publicado', despublicado: 'fora do ar' };
---
<Base titulo={n ? `Pré-visualização: ${n.titulo}` : 'Pré-visualização indisponível'} noindex
  migalhas={[{ nome: 'Notícias', href: '/noticias' }, { nome: 'Pré-visualização' }]}>
  {n ? (
    <>
      <div class="container">
        <p class="aviso-previa" role="status">
          <strong>Pré-visualização.</strong> É assim que a notícia vai aparecer no site. Situação atual: {situacao[n.status] ?? n.status}.
          {n.status !== 'publicado' && ' Só quem tem este link consegue ver, e o link vale por 30 minutos.'}
        </p>
      </div>
      <NoticiaArtigo n={n} />
    </>
  ) : (
    <div class="container">
      <header class="cabecalho-pagina">
        <h1>Pré-visualização indisponível</h1>
        <p>O link venceu (vale 30 minutos) ou não existe. Gere um novo no painel, no botão "Pré-visualizar".</p>
      </header>
    </div>
  )}
</Base>
