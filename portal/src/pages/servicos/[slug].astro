---
import Base from '../../layouts/Base.astro';
import { servico } from '../../lib/consultas';
import { moduloAtivo } from '../../lib/municipio';
import { htmlSeguro } from '../../lib/html';

const { municipio: m, dominioPrincipal } = Astro.locals.contexto;
if (!moduloAtivo(m, 'carta_servicos')) return Astro.rewrite('/404');
const s = await servico(m.id, Astro.params.slug!);
if (!s) return Astro.rewrite('/404');

const ld = {
  '@context': 'https://schema.org',
  '@type': 'GovernmentService',
  name: s.titulo,
  url: `https://${dominioPrincipal}/servicos/${s.slug}`,
  ...(s.descricao && { description: s.descricao }),
  ...(s.categoria && { serviceType: s.categoria.nome }),
  ...(s.publico_alvo && { audience: { '@type': 'Audience', audienceType: s.publico_alvo } }),
  provider: s.orgao ? { '@type': 'GovernmentOrganization', name: s.orgao.nome, parentOrganization: { '@id': `https://${dominioPrincipal}/#organizacao` } }
    : { '@id': `https://${dominioPrincipal}/#organizacao` },
  areaServed: { '@type': 'City', name: m.nome.replace(/^Prefeitura( Municipal)? d[eoa]s? /i, '') },
};
const blocos: [string, string | null][] = [
  ['Quem pode solicitar', s.publico_alvo],
  ['Prazo', s.prazo],
  ['Custo', s.custo],
  ['Canal de atendimento', s.canal_atendimento],
  ['Local e horário', s.local_horario],
];
---
<Base titulo={s.titulo} descricao={s.descricao ?? undefined} jsonLd={ld}
  migalhas={[{ nome: 'Serviços', href: '/servicos' }, ...(s.categoria ? [{ nome: s.categoria.nome, href: `/servicos?categoria=${s.categoria.slug}` }] : []), { nome: s.titulo }]}>
  <article class="container">
    <header class="cabecalho-pagina">
      <h1>{s.titulo}</h1>
      {s.descricao && <p>{s.descricao}</p>}
    </header>
    {s.url_externa && <p><a class="botao" href={s.url_externa} target="_blank" rel="noopener">Acessar o serviço on-line<span class="sr-only"> (abre em nova aba)</span></a></p>}
    <dl class="ficha">
      {blocos.filter(([, v]) => v).map(([r, v]) => <><dt>{r}</dt><dd>{v}</dd></>)}
      {s.orgao && <><dt>Órgão responsável</dt><dd><a href={`/estrutura-organizacional/${s.orgao.slug}`}>{s.orgao.nome}</a>{s.orgao.telefone && ` · ${s.orgao.telefone}`}</dd></>}
    </dl>
    {s.requisitos_html && <section class="conteudo"><h2>Documentos e requisitos</h2><div set:html={htmlSeguro(s.requisitos_html)} /></section>}
    {s.etapas_html && <section class="conteudo"><h2>Como solicitar</h2><div set:html={htmlSeguro(s.etapas_html)} /></section>}
  </article>
</Base>
