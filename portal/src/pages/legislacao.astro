---
import Base from '../layouts/Base.astro';
import ListaDocumentos from '../components/ListaDocumentos.astro';
import { moduloAtivo, ehPrefeitura } from '../lib/municipio';

const { municipio: m } = Astro.locals.contexto;
if (!moduloAtivo(m, 'legislacao')) return Astro.rewrite('/404');
// Categorias de atos normativos: configuráveis por município; padrão = as do provisionamento (0007).
const somente = m.config.legislacao_categorias ?? [
  'lei-organica', 'leis-complementares', 'leis-ordinarias', 'decretos', 'portarias', 'resolucoes',
];
// Secretaria, câmara etc. (D-90): "Legislação", com os atos da área, sem "municipal" nem Lei Orgânica.
const prefeitura = ehPrefeitura(m);
const titulo = prefeitura ? 'Legislação municipal' : 'Legislação';
---
<Base titulo={titulo} noindex={Astro.url.searchParams.has('q')}
  descricao={prefeitura
    ? `Lei Orgânica, leis, decretos, portarias e resoluções da ${m.nome}, com situação de vigência.`
    : `Leis, decretos, portarias e resoluções da área da ${m.nome}, com situação de vigência.`}
  migalhas={[{ nome: 'Legislação' }]}>
  <div class="container">
    <header class="cabecalho-pagina">
      <h1>{titulo}</h1>
      <p>{prefeitura
        ? 'Pesquise os atos normativos do município e veja se estão vigentes, alterados ou revogados.'
        : 'Pesquise as leis, decretos, portarias e resoluções da área e veja se estão vigentes, alterados ou revogados.'}</p>
    </header>
    <ListaDocumentos municipioId={m.id} somente={somente} comSituacao />
  </div>
</Base>
