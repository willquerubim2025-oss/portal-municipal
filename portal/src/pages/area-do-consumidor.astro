---
// Área do consumidor (D-139): página do portal, no mesmo visual, aberta só depois do login (a janela de login
// abre por cima, ModalConsumidor). Tudo o que aparece aqui vem do banco do SigDoc, no navegador do consumidor
// (lib/sigdoc-cliente.ts), protegido pelo RLS de lá. O servidor do portal só entrega a "casca" da página.
import Base from '../layouts/Base.astro';

const { municipio: m } = Astro.locals.contexto;
if (!m.config.area_consumidor?.cidade) return Astro.rewrite('/404');
Astro.response.headers.set('Cache-Control', 'no-store');
---
<Base titulo="Área do consumidor" descricao="Atendimento online, acompanhamento das reclamações e documentos do consumidor." migalhas={[{ nome: 'Área do consumidor' }]} noindex>
  <div class="container ac">
    <!-- Antes do login -->
    <section class="ac-fora" data-ac="fora">
      <div class="ac-girando-caixa" data-ac="verificando"><span class="sdc-girando"></span> Verificando o seu acesso...</div>
      <div data-ac="pedir-login" hidden>
        <h1>Área do consumidor</h1>
        <p>Entre com a sua conta para pedir atendimento online, conversar com o técnico do Procon e acompanhar as suas reclamações.</p>
        <button type="button" class="sdc-botao ac-botao-curto" data-area-consumidor>Entrar ou criar cadastro</button>
      </div>
    </section>

    <!-- Depois do login -->
    <div data-ac="dentro" hidden>
      <header class="ac-topo">
        <div>
          <p class="ac-sobre">Área do consumidor</p>
          <h1>Olá, <span data-ac-nome></span></h1>
          <p class="ac-cidade" data-ac-cidade></p>
        </div>
        <div class="ac-acoes-topo">
          <button type="button" class="ac-link" data-ac-ir="dados">Meus dados</button>
          <button type="button" class="ac-link ac-sair" data-ac-sair>Sair</button>
        </div>
      </header>

      <nav class="ac-abas" aria-label="Seções da área do consumidor">
        <button type="button" class="ac-aba" data-ac-ir="atendimento" aria-current="page">Atendimento online</button>
        <button type="button" class="ac-aba" data-ac-ir="historico">Meus atendimentos</button>
        <button type="button" class="ac-aba" data-ac-ir="documentos">Meus documentos</button>
        <button type="button" class="ac-aba" data-ac-ir="dados">Meus dados</button>
      </nav>

      <!-- Atendimento online -->
      <section class="ac-painel" data-ac-painel="atendimento">
        <div data-ac="sem-atendimento" hidden class="ac-cartao ac-chamada">
          <h2>Fale com um técnico do Procon</h2>
          <p>Conte o seu problema pelo chat. Você entra na fila e é atendido na ordem de chegada, no horário de atendimento do Procon.</p>
          <p class="ac-erro" role="alert" data-ac-erro-solicitar></p>
          <button type="button" class="ac-botao-p" data-ac-solicitar>Solicitar atendimento</button>
        </div>

        <div data-ac="com-atendimento" hidden class="ac-cartao ac-chamada ac-resumo">
          <div>
            <p class="ac-status" data-ac-status></p>
            <p class="ac-status-sub" data-ac-status-sub></p>
          </div>
          <button type="button" class="ac-botao-p" data-ac-abrir-chat>Abrir conversa</button>
        </div>
      </section>

      <!-- Meus atendimentos -->
      <section class="ac-painel" data-ac-painel="historico" hidden>
        <h2>Meus atendimentos</h2>
        <div data-ac-historico class="ac-lista"><p class="ac-vazio">Carregando...</p></div>
      </section>

      <!-- Meus documentos -->
      <section class="ac-painel" data-ac-painel="documentos" hidden>
        <h2>Meus documentos</h2>
        <p class="ac-sub">Documentos do Procon registrados no seu CPF (protocolos, cartas e respostas).</p>
        <div data-ac-documentos class="ac-lista"><p class="ac-vazio">Carregando...</p></div>
      </section>

      <!-- Meus dados -->
      <section class="ac-painel" data-ac-painel="dados" hidden>
        <h2>Meus dados</h2>
        <form class="ac-cartao ac-form-dados" data-ac-form-dados novalidate>
          <label class="sdc-campo">Nome completo<input name="fullName" maxlength="120" required /></label>
          <div class="sdc-duas">
            <label class="sdc-campo">CPF<input name="cpf" readonly aria-readonly="true" /></label>
            <label class="sdc-campo">RG<input name="rg" maxlength="20" /></label>
          </div>
          <div class="sdc-duas">
            <label class="sdc-campo">E-mail<input name="email" readonly aria-readonly="true" /></label>
            <label class="sdc-campo">Telefone (WhatsApp)<input name="phone" inputmode="tel" maxlength="15" data-ac-mascara="telefone" /></label>
          </div>
          <div class="sdc-tres">
            <label class="sdc-campo">CEP<input name="cep" inputmode="numeric" maxlength="9" data-ac-mascara="cep" /></label>
            <label class="sdc-campo">Nº<input name="addressNumber" maxlength="10" /></label>
            <label class="sdc-campo">Complemento<input name="complement" maxlength="60" /></label>
          </div>
          <p class="ac-sub">Para corrigir o CPF ou o e-mail, fale com o Procon.</p>
          <p class="ac-erro" role="alert" data-ac-erro-dados></p>
          <button type="submit" class="ac-botao-p">Salvar</button>
        </form>
      </section>

      <!-- Conversa: janela no canto da tela, no mesmo formato da do SigDoc -->
      <section class="ac-janela" data-ac-janela hidden aria-label="Conversa com o técnico">
        <header class="ac-j-topo">
          <div class="ac-j-info">
            <h2>Atendimento</h2>
            <p data-ac-j-quem></p>
            <p class="ac-j-tecnico" data-ac-j-tecnico></p>
          </div>
          <button type="button" class="ac-j-icone" data-ac-minimizar title="Minimizar" aria-label="Minimizar"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/></svg></button>
          <button type="button" class="ac-j-icone ac-j-fechar" data-ac-encerrar title="Encerrar atendimento" aria-label="Encerrar atendimento"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"/></svg></button>
        </header>
        <ol class="ac-mensagens" data-ac-mensagens aria-live="polite"></ol>
        <p class="ac-erro ac-j-erro" role="alert" data-ac-erro-msg></p>
        <form class="ac-enviar" data-ac-form-msg>
          <label class="ac-j-botao" title="Anexar PDF ou documento">
            <input type="file" class="sr-only" data-ac-arquivo accept="application/pdf,.doc,.docx,.xls,.xlsx,.txt,audio/*,image/*" />
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m21.4 11.1-9.2 9.2a6 6 0 0 1-8.5-8.5l9.2-9.2a4 4 0 0 1 5.7 5.7l-9.2 9.2a2 2 0 0 1-2.8-2.8l8.5-8.5"/></svg>
            <span class="sr-only">Anexar arquivo</span>
          </label>
          <label class="ac-j-botao" title="Tirar ou enviar foto">
            <input type="file" class="sr-only" data-ac-arquivo accept="image/*" capture="environment" />
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 9a2 2 0 0 1 2-2h1l2-3h8l2 3h1a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><circle cx="12" cy="13" r="3.2"/></svg>
            <span class="sr-only">Enviar foto</span>
          </label>
          <label class="sr-only" for="ac-texto">Mensagem</label>
          <input id="ac-texto" name="texto" type="text" maxlength="4000" autocomplete="off" placeholder="Digite sua mensagem..." />
          <button type="submit" class="ac-j-botao ac-j-enviar" data-ac-enviar-btn hidden title="Enviar" aria-label="Enviar"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m22 2-7 20-4-9-9-4z"/><path d="M22 2 11 13"/></svg></button>
          <button type="button" class="ac-j-botao" data-ac-gravar title="Gravar áudio" aria-label="Gravar áudio"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="2" width="6" height="12" rx="3"/><path d="M5 10a7 7 0 0 0 14 0M12 19v3"/></svg></button>
        </form>
        <div class="ac-enviar ac-gravando" data-ac-gravando hidden>
          <button type="button" class="ac-j-botao" data-ac-cancelar-audio title="Cancelar gravação" aria-label="Cancelar gravação"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"/></svg></button>
          <span class="ac-ponto"></span><span class="ac-gravando-txt">Gravando <span data-ac-tempo>0:00</span></span>
          <button type="button" class="ac-j-botao ac-j-enviar" data-ac-enviar-audio title="Parar e enviar o áudio" aria-label="Parar e enviar o áudio"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" fill="currentColor"><rect x="6" y="6" width="12" height="12" rx="2"/></svg></button>
        </div>
      </section>
      <button type="button" class="ac-janela-min" data-ac-min hidden>
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
        <span>Atendimento</span><small data-ac-min-status></small>
      </button>
    </div>
  </div>
</Base>

<style is:global>
  .ac { padding-block: clamp(20px, 4vw, 40px) 60px; }
  .ac [hidden] { display: none !important; }
  .ac h1 { font-family: var(--v-fonte-titulos, inherit); margin: 0 0 8px; font-size: clamp(1.7rem, 4vw, 2.3rem); line-height: 1.1; }
  .ac h2 { font-family: var(--v-fonte-titulos, inherit); margin: 0 0 10px; font-size: 1.35rem; }
  .ac-fora { max-width: 640px; margin: 20px auto; text-align: center; }
  .ac-fora p { color: #4b5b52; font-size: 1.05rem; }
  .ac-girando-caixa { display: flex; align-items: center; justify-content: center; gap: 12px; padding: 40px 0; font-weight: 700; color: #4b5b52; }
  .ac-girando-caixa[hidden] { display: none; }
  .ac-botao-curto { width: auto; padding-inline: 28px; }
  .ac-topo { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: flex-end; gap: 12px; padding-bottom: 18px; border-bottom: 1px solid #dfe5df; }
  .ac-sobre { margin: 0 0 6px; font-size: .78rem; font-weight: 800; letter-spacing: .08em; text-transform: uppercase; color: var(--cor-primaria, #027538); }
  .ac-cidade { margin: 0; color: #4b5b52; }
  .ac-acoes-topo { display: flex; gap: 16px; }
  .ac-link { border: 0; background: none; padding: 6px 0; font: inherit; font-weight: 700; color: var(--cor-secundaria, #05437b); text-decoration: underline; cursor: pointer; }
  .ac-sair { color: #b42318; }
  .ac-abas { display: flex; gap: 8px; overflow-x: auto; padding: 18px 0; scrollbar-width: thin; }
  .ac-aba { flex: none; border: 1.5px solid #cfd8d1; background: #fff; border-radius: 999px; padding: 7px 15px; font-size: .92rem; font: inherit; font-weight: 700; cursor: pointer; color: #2b3a31; }
  .ac-aba[aria-current="page"] { background: var(--cor-primaria, #027538); border-color: var(--cor-primaria, #027538); color: #fff; }
  .ac-painel[hidden] { display: none; }
  .ac-cartao { background: #fff; border: 1px solid #dfe5df; border-radius: 20px; padding: clamp(18px, 4vw, 28px); box-shadow: 0 8px 30px rgba(10, 40, 20, .06); }
  .ac-chamada { max-width: 720px; }
  .ac-chamada p { color: #4b5b52; }
  .ac-sub { color: #4b5b52; margin: 0 0 14px; }
  .ac-erro { color: #b42318; font-weight: 700; margin: 8px 0; }
  .ac-erro:empty { display: none; }
  .ac-erro.ac-ok { color: #0f7a3d; }
  .ac-status { margin: 0; font-weight: 800; font-size: 1.05rem; }
  .ac-status-sub { margin: 2px 0 0; color: #4b5b52; font-size: .95rem; }
  .ac-resumo { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 12px; }
  .ac-botao-p { display: inline-flex; align-items: center; gap: 6px; padding: 8px 18px; border: 1.5px solid var(--cor-primaria, #027538); border-radius: 999px; background: var(--cor-primaria, #027538); color: #fff; font: inherit; font-weight: 700; font-size: .92rem; cursor: pointer; }
  .ac-botao-p:hover { filter: brightness(1.08); }
  .ac-botao-p:disabled { opacity: .6; cursor: wait; }
  /* Janela da conversa (formato da janela do consumidor no SigDoc) */
  .ac-janela { position: fixed; right: 16px; bottom: 16px; z-index: 900; width: 26rem; height: min(620px, calc(100dvh - 32px)); display: flex; flex-direction: column; background: #fff; border: 1px solid #dfe5df; border-radius: 16px; box-shadow: 0 18px 50px rgba(0,0,0,.22); overflow: hidden; }
  .ac-j-topo { display: flex; align-items: flex-start; gap: 4px; padding: 12px 12px 10px 16px; border-bottom: 3px solid var(--cor-primaria, #027538); }
  .ac-j-info { flex: 1; min-width: 0; }
  .ac-j-info h2 { margin: 0; font-size: .82rem; font-weight: 800; letter-spacing: .08em; text-transform: uppercase; }
  .ac-j-info p { margin: 1px 0 0; font-size: .74rem; color: #6b7a71; text-transform: uppercase; letter-spacing: .03em; }
  .ac-j-info .ac-j-tecnico { color: var(--cor-primaria, #027538); font-weight: 700; }
  .ac-j-info .ac-j-tecnico:empty { display: none; }
  .ac-j-icone { flex: none; display: inline-flex; padding: 5px; border: 0; background: none; color: #6b7a71; cursor: pointer; border-radius: 8px; }
  .ac-j-icone:hover { background: #eef2ef; color: #13231a; }
  .ac-j-fechar { color: #b42318; }
  .ac-mensagens { flex: 1; list-style: none; margin: 0; padding: 14px; overflow-y: auto; background: #f4f6f5; display: flex; flex-direction: column; gap: 8px; }
  .ac-msg { max-width: 80%; padding: 8px 11px; border-radius: 14px; background: #fff; border: 1px solid #e3e9e4; align-self: flex-start; white-space: pre-wrap; overflow-wrap: anywhere; font-size: .9rem; line-height: 1.35; }
  .ac-msg-eu { align-self: flex-end; background: var(--cor-primaria, #027538); border-color: var(--cor-primaria, #027538); color: #fff; }
  .ac-msg-eu .ac-link { color: #fff; }
  .ac-msg-sistema { align-self: center; max-width: 92%; background: #fff7d6; border-color: #f1e2a0; font-size: .8rem; text-align: center; }
  .ac-msg small { display: block; margin-top: 3px; font-size: .62rem; font-weight: 700; opacity: .65; text-transform: uppercase; }
  .ac-msg strong { display: block; font-size: .72rem; margin-bottom: 1px; }
  .ac-msg .ac-link { font-size: .82rem; padding: 2px 0; text-align: left; }
  .ac-msg audio { width: 220px; max-width: 100%; height: 36px; margin-top: 2px; }
  .ac-msg img { display: block; max-width: 200px; max-height: 200px; border-radius: 8px; margin-top: 2px; cursor: zoom-in; }
  .ac-j-erro { margin: 0; padding: 6px 12px; font-size: .82rem; background: #fff; }
  .ac-enviar { display: flex; align-items: center; gap: 6px; padding: 10px 12px; border-top: 1px solid #e3e9e4; background: #fff; }
  .ac-enviar input[type="text"] { flex: 1; min-width: 0; font: inherit; font-size: .92rem; padding: 8px 11px; border: 1px solid #cfd8d1; border-radius: 10px; }
  .ac-enviar input[type="text"]:focus { outline: none; border-color: var(--cor-primaria, #027538); }
  .ac-j-botao { flex: none; display: inline-flex; align-items: center; justify-content: center; width: 36px; height: 36px; border: 1px solid #cfd8d1; border-radius: 10px; background: #f6f8f7; color: #4b5b52; cursor: pointer; }
  .ac-j-botao:hover { background: #eaefec; color: #13231a; }
  .ac-j-botao:focus-within, .ac-j-botao:focus-visible { outline: 2px solid var(--cor-primaria, #027538); outline-offset: 1px; }
  .ac-j-enviar { background: var(--cor-primaria, #027538); border-color: var(--cor-primaria, #027538); color: #fff; }
  .ac-j-enviar:hover { background: var(--cor-primaria, #027538); color: #fff; filter: brightness(1.1); }
  .ac-gravando { background: #fdf0ef; }
  .ac-gravando-txt { flex: 1; font-size: .88rem; font-weight: 700; color: #b42318; }
  .ac-ponto { width: 10px; height: 10px; border-radius: 50%; background: #d92d20; animation: ac-pisca 1s infinite; }
  @keyframes ac-pisca { 50% { opacity: .25; } }
  .ac-janela-min { position: fixed; right: 16px; bottom: 16px; z-index: 900; display: flex; align-items: center; gap: 8px; min-width: 240px; padding: 11px 14px; border: 2px solid rgba(255,255,255,.75); border-radius: 12px; background: var(--cor-primaria, #027538); color: #fff; font: inherit; font-size: .82rem; font-weight: 800; letter-spacing: .06em; text-transform: uppercase; box-shadow: 0 10px 30px rgba(0,0,0,.25); cursor: pointer; }
  .ac-janela-min small { margin-left: auto; padding: 2px 8px; border-radius: 6px; background: rgba(255,255,255,.2); font-size: .7rem; letter-spacing: 0; text-transform: none; }
  @media (max-width: 640px) { .ac-janela { inset: 0; width: auto; height: auto; border-radius: 0; border: 0; } }
  .ac-lista { display: grid; gap: 12px; }
  .ac-item { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 10px; padding: 16px 18px; border: 1px solid #dfe5df; border-radius: 16px; background: #fff; }
  .ac-item h3 { margin: 0 0 4px; font-size: 1.02rem; }
  .ac-item p { margin: 0; color: #4b5b52; font-size: .92rem; }
  .ac-etiqueta { display: inline-block; padding: 3px 10px; border-radius: 999px; font-size: .78rem; font-weight: 800; background: #eef2ef; color: #2b3a31; }
  .ac-etiqueta-aguardando { background: #fff3c4; color: #7a5a00; }
  .ac-etiqueta-andamento { background: #dbeafe; color: #1e40af; }
  .ac-etiqueta-concluido { background: #dcfce7; color: #166534; }
  .ac-vazio { color: #6b7a71; }
  .ac-form-dados { max-width: 720px; }
  .ac-form-dados input[readonly] { background: #eef2ef; color: #4b5b52; }
</style>

<script>
  import {
    situacaoAtual, sair, atendimentoAberto, solicitarAtendimento, lerAtendimento, enviarMensagem, enviarArquivo, encerrarAtendimento,
    ouvirAtendimento, posicaoNaFila, historico, documentos, linkArquivo, salvarDados, mascaraCpf, mascaraTelefone, mascaraCep,
    type Consumidor, type Atendimento, type Mensagem,
  } from '../lib/sigdoc-cliente';

  const $ = <T extends HTMLElement = HTMLElement>(sel: string) => document.querySelector<T>(sel)!;
  const el = (tag: string, cls?: string, texto?: string) => { const e = document.createElement(tag); if (cls) e.className = cls; if (texto != null) e.textContent = texto; return e; };
  const dataHora = (iso?: string | null) => iso ? new Date(iso).toLocaleString('pt-BR', { day: '2-digit', month: '2-digit', year: 'numeric', hour: '2-digit', minute: '2-digit' }) : '';
  const hora = (iso?: string | null) => iso ? new Date(iso).toLocaleTimeString('pt-BR', { hour: '2-digit', minute: '2-digit' }) : '';

  let eu: Consumidor | null = null;
  let atual: Atendimento | null = null;
  let pararDeOuvir: (() => void) | null = null;
  let qtdMensagens = -1;
  const carregado = new Set<string>();

  // ---------- Abas ----------
  const abrirAba = (nome: string) => {
    document.querySelectorAll<HTMLElement>('[data-ac-painel]').forEach((p) => { p.hidden = p.dataset.acPainel !== nome; });
    document.querySelectorAll<HTMLElement>('.ac-aba').forEach((a) => { if (a.dataset.acIr === nome) a.setAttribute('aria-current', 'page'); else a.removeAttribute('aria-current'); });
    if (nome === 'historico' && !carregado.has(nome)) { carregado.add(nome); carregarHistorico(); }
    if (nome === 'documentos' && !carregado.has(nome)) { carregado.add(nome); carregarDocumentos(); }
    if (nome === 'dados') preencherDados();
  };
  document.querySelectorAll<HTMLElement>('[data-ac-ir]').forEach((b) => b.addEventListener('click', () => abrirAba(b.dataset.acIr!)));

  // ---------- Entrada ----------
  async function iniciar() {
    const s = await situacaoAtual().catch(() => ({ tipo: 'sem-login' as const }));
    $('[data-ac="verificando"]').hidden = true;
    if (s.tipo !== 'ok') {
      $('[data-ac="pedir-login"]').hidden = false;
      window.dispatchEvent(new CustomEvent('sdc:abrir'));
      return;
    }
    eu = s.consumidor;
    $('[data-ac="fora"]').hidden = true;
    $('[data-ac="dentro"]').hidden = false;
    $('[data-ac-nome]').textContent = (eu.fullName || '').split(' ')[0] || 'consumidor';
    $('[data-ac-cidade]').textContent = eu.city ? `Cidade do cadastro: ${eu.city}` : '';
    await atualizarAtendimento();
  }
  window.addEventListener('sdc:logado', () => { $('[data-ac="pedir-login"]').hidden = true; $('[data-ac="verificando"]').hidden = false; iniciar(); });
  $('[data-ac-sair]').addEventListener('click', async () => { pararDeOuvir?.(); await sair(); location.href = '/'; });

  // ---------- Atendimento online ----------
  async function atualizarAtendimento() {
    if (!eu) return;
    const a = atual ? await lerAtendimento(atual.id) : await atendimentoAberto(eu.id);
    if (a && a.status === 'completed') {
      atual = null; pararDeOuvir?.(); pararDeOuvir = null; qtdMensagens = -1;
      mostrarSemAtendimento('Seu último atendimento foi encerrado. Se precisar, solicite um novo.');
      carregado.delete('historico');
      return;
    }
    if (!a) { mostrarSemAtendimento(); return; }
    const novo = !atual || atual.id !== a.id;
    atual = a;
    if (novo) { pararDeOuvir?.(); pararDeOuvir = ouvirAtendimento(a.id, () => { atualizarAtendimento(); }); }
    await desenharAtendimento(a);
  }

  // Janela da conversa: aberta, minimizada (barra no canto) ou fechada (sem atendimento).
  let minimizada = false;
  const janela = $('[data-ac-janela]');
  const barraMin = $('[data-ac-min]');
  const mostrarJanela = (abrir: boolean) => {
    if (abrir) minimizada = false;
    janela.hidden = minimizada; barraMin.hidden = !minimizada;
    if (!minimizada) { const l = $('[data-ac-mensagens]'); l.scrollTop = l.scrollHeight; }
  };
  $('[data-ac-minimizar]').addEventListener('click', () => { minimizada = true; mostrarJanela(false); });
  barraMin.addEventListener('click', () => { mostrarJanela(true); $('#ac-texto').focus(); });
  $('[data-ac-abrir-chat]').addEventListener('click', () => { mostrarJanela(true); $('#ac-texto').focus(); });

  function mostrarSemAtendimento(aviso = '') {
    janela.hidden = true; barraMin.hidden = true; minimizada = false;
    $('[data-ac="com-atendimento"]').hidden = true;
    $('[data-ac="sem-atendimento"]').hidden = false;
    const e = $('[data-ac-erro-solicitar]');
    e.textContent = aviso; e.classList.toggle('ac-ok', !!aviso);
  }

  async function desenharAtendimento(a: Atendimento) {
    $('[data-ac="sem-atendimento"]').hidden = true;
    $('[data-ac="com-atendimento"]').hidden = false;
    let resumo: string;
    if (a.status === 'waiting') {
      const pos = await posicaoNaFila(a);
      resumo = pos ? `Na fila: posição ${pos}` : 'Na fila';
      $('[data-ac-status]').textContent = pos ? `Você está na fila: posição ${pos}` : 'Você está na fila';
      $('[data-ac-status-sub]').textContent = 'A conversa fica aberta no canto da tela. Quando o técnico começar, as mensagens dele aparecem lá.';
      $('[data-ac-j-tecnico]').textContent = resumo;
    } else {
      resumo = 'Em atendimento';
      $('[data-ac-status]').textContent = 'Em atendimento';
      $('[data-ac-status-sub]').textContent = a.attendedBy ? `Técnico: ${a.attendedBy}` : 'Um técnico está atendendo você.';
      $('[data-ac-j-tecnico]').textContent = a.attendedBy ? `Você está sendo atendido por ${a.attendedBy}` : 'Em atendimento';
    }
    $('[data-ac-j-quem]').textContent = [eu?.fullName, eu?.cpf ? mascaraCpf(eu.cpf) : ''].filter(Boolean).join(' • ');
    $('[data-ac-min-status]').textContent = resumo;
    if (janela.hidden && barraMin.hidden) mostrarJanela(true);
    const msgs = (a.messages || []) as Mensagem[];
    if (msgs.length === qtdMensagens) return;
    const lista = $('[data-ac-mensagens]');
    const estavaNoFim = lista.scrollHeight - lista.scrollTop - lista.clientHeight < 80;
    lista.replaceChildren(...msgs.map(desenharMensagem));
    if (estavaNoFim || qtdMensagens < 0) lista.scrollTop = lista.scrollHeight;
    qtdMensagens = msgs.length;
  }

  function desenharMensagem(m: Mensagem) {
    const sistema = m.senderId === 'system';
    const meu = m.senderType === 'consumer';
    const li = el('li', `ac-msg ${sistema ? 'ac-msg-sistema' : meu ? 'ac-msg-eu' : ''}`);
    if (!sistema && !meu) li.append(el('strong', '', m.senderName || 'Técnico'));
    if (m.type === 'audio' && m.fileUrl) {
      const audio = document.createElement('audio'); audio.controls = true; audio.preload = 'none';
      linkArquivo(m.fileUrl).then((u) => { if (u) audio.src = u; });
      li.append(audio);
    } else if (m.type === 'file' && m.fileUrl) {
      const nome = m.content || 'arquivo';
      if (/\.(jpe?g|png|webp|gif|heic|heif)$/i.test(nome) || /\.(jpe?g|png|webp|gif)(\?|$)/i.test(m.fileUrl)) {
        const img = document.createElement('img'); img.alt = nome; img.loading = 'lazy';
        linkArquivo(m.fileUrl).then((u) => { if (u) img.src = u; });
        img.addEventListener('click', () => { if (img.src) window.open(img.src, '_blank', 'noopener'); });
        li.append(img);
      } else {
        const b = el('button', 'ac-link', `📄 ${nome}`);
        b.title = 'Abrir arquivo';
        b.addEventListener('click', async () => { const u = await linkArquivo(m.fileUrl!); if (u) window.open(u, '_blank', 'noopener'); });
        li.append(b);
      }
    } else {
      li.append(document.createTextNode(m.content || ''));
    }
    li.append(el('small', '', hora(m.timestamp)));
    return li;
  }

  $('[data-ac-solicitar]').addEventListener('click', async (e) => {
    if (!eu) return;
    const b = e.currentTarget as HTMLButtonElement;
    b.disabled = true;
    const r = await solicitarAtendimento(eu);
    b.disabled = false;
    if (r.erro) { const er = $('[data-ac-erro-solicitar]'); er.textContent = r.erro; er.classList.remove('ac-ok'); return; }
    atual = null; qtdMensagens = -1;
    await atualizarAtendimento();
    $('#ac-texto').focus();
  });

  $<HTMLFormElement>('[data-ac-form-msg]').addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!eu || !atual) return;
    const campo = $<HTMLInputElement>('#ac-texto');
    const texto = campo.value.trim();
    if (!texto) return;
    const er = $('[data-ac-erro-msg]');
    er.textContent = '';
    campo.value = '';
    const r = await enviarMensagem(atual, eu, texto);
    if (r.erro) { er.textContent = r.erro; campo.value = texto; return; }
    await atualizarAtendimento();
    const lista = $('[data-ac-mensagens]'); lista.scrollTop = lista.scrollHeight;
  });
  // Igual ao SigDoc: com texto aparece "enviar"; sem texto, o microfone.
  const trocarBotao = () => {
    const tem = !!$<HTMLInputElement>('#ac-texto').value.trim();
    $('[data-ac-enviar-btn]').hidden = !tem; $('[data-ac-gravar]').hidden = tem;
  };
  $('#ac-texto').addEventListener('input', trocarBotao);
  $('[data-ac-form-msg]').addEventListener('submit', () => setTimeout(trocarBotao, 0));

  // ---------- Foto, documento e áudio ----------
  const erroMsg = (t: string) => { $('[data-ac-erro-msg]').textContent = t; };
  document.querySelectorAll<HTMLInputElement>('[data-ac-arquivo]').forEach((entrada) => entrada.addEventListener('change', async (e) => {
    const input = e.currentTarget as HTMLInputElement;
    const arq = input.files?.[0];
    input.value = '';
    if (!arq || !eu || !atual) return;
    erroMsg('Enviando o arquivo...');
    const r = await enviarArquivo(atual, eu, arq, arq.name, arq.type.startsWith('audio/') ? 'audio' : 'file');
    erroMsg(r.erro ?? '');
    if (!r.erro) { await atualizarAtendimento(); const l = $('[data-ac-mensagens]'); l.scrollTop = l.scrollHeight; }
  }));

  let gravador: MediaRecorder | null = null;
  let pedacos: BlobPart[] = [];
  let cancelado = false;
  let relogio: number | undefined;
  const caixaGravando = $('[data-ac-gravando]');
  const formMsg = $('[data-ac-form-msg]');
  const pararRelogio = () => { clearInterval(relogio); caixaGravando.hidden = true; formMsg.hidden = false; };
  $('[data-ac-gravar]').addEventListener('click', async () => {
    if (!eu || !atual || gravador) return;
    if (!navigator.mediaDevices?.getUserMedia || typeof MediaRecorder === 'undefined') { erroMsg('Este navegador não grava áudio. Mande por texto ou como arquivo.'); return; }
    let fluxo: MediaStream;
    try { fluxo = await navigator.mediaDevices.getUserMedia({ audio: true }); }
    catch { erroMsg('Não foi possível usar o microfone. Libere o microfone para este site e tente de novo.'); return; }
    erroMsg('');
    // Mesmas escolhas do SigDoc: o navegador escolhe o formato; taxa fixa evita áudio mudo no Chrome do Android.
    gravador = new MediaRecorder(fluxo, { audioBitsPerSecond: 128000 });
    pedacos = []; cancelado = false;
    const tipo = gravador.mimeType || 'audio/mp4';
    gravador.ondataavailable = (ev) => { if (ev.data && ev.data.size > 0) pedacos.push(ev.data); };
    gravador.onstop = async () => {
      fluxo.getTracks().forEach((t) => t.stop());
      gravador = null; pararRelogio();
      if (cancelado || !eu || !atual || !pedacos.length) return;
      erroMsg('Enviando o áudio...');
      const r = await enviarArquivo(atual, eu, new Blob(pedacos, { type: tipo }), 'audio', 'audio');
      erroMsg(r.erro ?? '');
      if (!r.erro) { await atualizarAtendimento(); const l = $('[data-ac-mensagens]'); l.scrollTop = l.scrollHeight; }
    };
    gravador.start(250);
    const inicio = Date.now();
    const tempo = $('[data-ac-tempo]');
    tempo.textContent = '0:00';
    relogio = window.setInterval(() => {
      const s = Math.floor((Date.now() - inicio) / 1000);
      tempo.textContent = `${Math.floor(s / 60)}:${String(s % 60).padStart(2, '0')}`;
      if (s >= 300) gravador?.stop(); // até 5 minutos
    }, 500);
    formMsg.hidden = true; caixaGravando.hidden = false;
  });
  $('[data-ac-cancelar-audio]').addEventListener('click', () => { cancelado = true; gravador?.stop(); });
  $('[data-ac-enviar-audio]').addEventListener('click', () => { gravador?.stop(); });

  $('[data-ac-encerrar]').addEventListener('click', async () => {
    if (!atual || !confirm('Encerrar este atendimento? Se precisar depois, você pode solicitar um novo.')) return;
    const r = await encerrarAtendimento(atual);
    if (r.erro) { $('[data-ac-erro-msg]').textContent = r.erro; return; }
    await atualizarAtendimento();
  });

  // ---------- Meus atendimentos ----------
  const STATUS: Record<string, [string, string]> = {
    waiting: ['Aguardando', 'ac-etiqueta-aguardando'], 'in-progress': ['Em atendimento', 'ac-etiqueta-andamento'], completed: ['Finalizado', 'ac-etiqueta-concluido'],
  };
  async function carregarHistorico() {
    const caixa = $('[data-ac-historico]');
    if (!eu?.cpf) { caixa.replaceChildren(el('p', 'ac-vazio', 'Nenhum atendimento encontrado.')); return; }
    const itens = await historico(eu.cpf);
    if (!itens.length) { caixa.replaceChildren(el('p', 'ac-vazio', 'Você ainda não tem atendimentos online.')); return; }
    caixa.replaceChildren(...itens.map((a) => {
      const div = el('div', 'ac-item');
      const info = el('div');
      info.append(el('h3', '', `Atendimento de ${dataHora(a.createdAt)}`));
      info.append(el('p', '', a.attendedBy ? `Técnico: ${a.attendedBy}` : 'Aguardando técnico'));
      const [rot, cls] = STATUS[a.status] ?? [a.status, ''];
      const lado = el('div');
      lado.append(el('span', `ac-etiqueta ${cls}`, rot));
      if (a.transcriptionPdf) {
        const b = el('button', 'ac-link', ' Ver conversa (PDF)');
        b.addEventListener('click', async () => { const u = await linkArquivo(a.transcriptionPdf!); if (u) window.open(u, '_blank', 'noopener'); });
        lado.append(b);
      }
      div.append(info, lado);
      return div;
    }));
  }

  // ---------- Meus documentos ----------
  async function carregarDocumentos() {
    const caixa = $('[data-ac-documentos]');
    if (!eu?.cpf) { caixa.replaceChildren(el('p', 'ac-vazio', 'Nenhum documento disponível.')); return; }
    const docs = await documentos(eu.cpf);
    if (!docs.length) { caixa.replaceChildren(el('p', 'ac-vazio', 'Nenhum documento disponível ainda.')); return; }
    caixa.replaceChildren(...docs.map((d) => {
      const div = el('div', 'ac-item');
      const info = el('div');
      info.append(el('h3', '', d.documentType || 'Documento'));
      info.append(el('p', '', [dataHora(d.dateTime), d.contentSnippet ? d.contentSnippet.slice(0, 140) : ''].filter(Boolean).join(' · ')));
      const b = el('button', 'ac-botao-p', 'Ver PDF');
      b.addEventListener('click', async () => { const u = await linkArquivo(d.pdfData!); if (u) window.open(u, '_blank', 'noopener'); });
      div.append(info, b);
      return div;
    }));
  }

  // ---------- Meus dados ----------
  const formDados = $<HTMLFormElement>('[data-ac-form-dados]');
  const campoDados = (n: string) => formDados.elements.namedItem(n) as HTMLInputElement;
  function preencherDados() {
    if (!eu) return;
    campoDados('fullName').value = eu.fullName || '';
    campoDados('cpf').value = mascaraCpf(eu.cpf || '');
    campoDados('rg').value = eu.rg || '';
    campoDados('email').value = eu.email || '';
    campoDados('phone').value = mascaraTelefone(eu.phone || '');
    campoDados('cep').value = mascaraCep(eu.cep || '');
    campoDados('addressNumber').value = eu.addressNumber || '';
    campoDados('complement').value = eu.complement || '';
    $('[data-ac-erro-dados]').textContent = '';
  }
  formDados.querySelectorAll<HTMLInputElement>('[data-ac-mascara]').forEach((i) => i.addEventListener('input', () => {
    i.value = i.dataset.acMascara === 'telefone' ? mascaraTelefone(i.value) : mascaraCep(i.value);
  }));
  formDados.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!eu) return;
    const er = $('[data-ac-erro-dados]');
    const nome = campoDados('fullName').value.trim();
    if (nome.length < 5) { er.textContent = 'Informe o nome completo.'; er.classList.remove('ac-ok'); return; }
    const dados = {
      fullName: nome, rg: campoDados('rg').value.trim() || null, phone: campoDados('phone').value.trim() || null,
      cep: campoDados('cep').value.trim() || null, addressNumber: campoDados('addressNumber').value.trim() || null,
      complement: campoDados('complement').value.trim() || null,
    };
    const r = await salvarDados(eu.id, dados);
    if (r.erro) { er.textContent = r.erro; er.classList.remove('ac-ok'); return; }
    eu = { ...eu, ...dados, cep: dados.cep ? dados.cep.replace(/\D/g, '') : null };
    $('[data-ac-nome]').textContent = nome.split(' ')[0];
    er.textContent = 'Dados salvos.'; er.classList.add('ac-ok');
  });

  iniciar();
</script>
