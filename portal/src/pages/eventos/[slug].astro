---
import Base from '../../layouts/Base.astro';
import { evento } from '../../lib/consultas';
import { moduloAtivo } from '../../lib/municipio';
import { urlMidia } from '../../lib/supabase';
import { htmlSeguro } from '../../lib/html';
import { dataExtenso, hora, resumir } from '../../lib/formato';

const { municipio: m, dominioPrincipal } = Astro.locals.contexto;
if (!moduloAtivo(m, 'agenda')) return Astro.rewrite('/404');
const e = await evento(m.id, Astro.params.slug!);
if (!e) return Astro.rewrite('/404');

const img = urlMidia(e.imagem?.storage_path);
const quando = `${dataExtenso(e.inicio_em)}${e.dia_inteiro ? '' : `, ${hora(e.inicio_em)}`}`
  + (e.fim_em ? ` até ${dataExtenso(e.fim_em) === dataExtenso(e.inicio_em) ? '' : `${dataExtenso(e.fim_em)}, `}${e.dia_inteiro ? '' : hora(e.fim_em)}` : '');
const ld = {
  '@context': 'https://schema.org',
  '@type': 'Event',
  name: e.titulo,
  startDate: e.inicio_em,
  ...(e.fim_em && { endDate: e.fim_em }),
  eventStatus: 'https://schema.org/EventScheduled',
  eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
  ...(e.local && { location: { '@type': 'Place', name: e.local, address: e.endereco ?? e.local } }),
  ...(img && { image: [img] }),
  description: e.resumo ?? resumir(e.descricao_html),
  organizer: { '@id': `https://${dominioPrincipal}/#organizacao` },
};
---
<Base titulo={e.titulo} descricao={e.resumo || resumir(e.descricao_html)} imagem={img} jsonLd={ld}
  migalhas={[{ nome: 'Agenda', href: '/eventos' }, { nome: e.titulo }]}>
  <article class="container">
    <header class="cabecalho-pagina">
      <h1>{e.titulo}</h1>
      {e.resumo && <p>{e.resumo}</p>}
    </header>
    <dl class="ficha">
      <dt>Quando</dt><dd><time datetime={e.inicio_em}>{quando}</time></dd>
      {e.local && <><dt>Local</dt><dd>{e.local}{e.endereco && ` — ${e.endereco}`}</dd></>}
      {e.orgao && <><dt>Organização</dt><dd><a href={`/estrutura-organizacional/${e.orgao.slug}`}>{e.orgao.nome}</a></dd></>}
    </dl>
    {e.url_externa && <p><a class="botao" href={e.url_externa} target="_blank" rel="noopener">Inscrição / mais informações<span class="sr-only"> (abre em nova aba)</span></a></p>}
    {img && <figure class="figura-destaque"><img src={img} alt={e.imagem.texto_alternativo ?? ''} width="1200" height="675" /></figure>}
    {e.descricao_html && <div class="conteudo" set:html={htmlSeguro(e.descricao_html)} />}
  </article>
</Base>
