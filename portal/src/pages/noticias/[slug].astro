---
import Base from '../../layouts/Base.astro';
import NoticiaArtigo from '../../components/NoticiaArtigo.astro';
import { noticia } from '../../lib/consultas';
import { urlMidia } from '../../lib/supabase';
import { resumir } from '../../lib/formato';

const { municipio: m, dominioPrincipal } = Astro.locals.contexto;
const n = await noticia(m.id, Astro.params.slug!);
if (!n) return Astro.rewrite('/404');

const img = urlMidia(n.imagem?.storage_path);
const ld = {
  '@context': 'https://schema.org',
  '@type': 'NewsArticle',
  headline: n.titulo,
  datePublished: n.publicado_em,
  dateModified: n.atualizado_em ?? n.publicado_em,
  ...(img && { image: [img] }),
  ...(n.resumo && { description: n.resumo }),
  mainEntityOfPage: `https://${dominioPrincipal}/noticias/${n.slug}`,
  publisher: { '@id': `https://${dominioPrincipal}/#organizacao` },
  author: { '@id': `https://${dominioPrincipal}/#organizacao` },
};
---
<Base titulo={n.titulo} descricao={n.resumo || resumir(n.corpo_html)} imagem={img} tipoOg="article" jsonLd={ld}
  migalhas={[{ nome: 'Notícias', href: '/noticias' }, { nome: n.titulo }]}>
  <NoticiaArtigo n={n} />
</Base>
