---
// Páginas institucionais (tabela paginas), por caminho completo: /o-municipio,
// /acesso-a-informacao, /secretarias/saude/programas... As rotas específicas
// (notícias, documentos...) têm prioridade sobre esta.
import Base from '../layouts/Base.astro';
import { pagina } from '../lib/consultas';
import PaginaArtigo from '../components/PaginaArtigo.astro';
import { resumir } from '../lib/formato';

const { municipio: m } = Astro.locals.contexto;
const caminho = (Astro.params.caminho ?? '').toLowerCase();
if (!/^[a-z0-9-]+(\/[a-z0-9-]+)*$/.test(caminho)) return Astro.rewrite('/404');
const p = await pagina(m.id, caminho);
if (!p) return Astro.rewrite('/404');

// Migalhas a partir dos segmentos do caminho (os intermediários viram link se existirem).
const segmentos = caminho.split('/');
const migalhas = segmentos.map((_, i) => {
  const href = `/${segmentos.slice(0, i + 1).join('/')}`;
  return i === segmentos.length - 1 ? { nome: p.titulo } : { nome: segmentos[i].replace(/-/g, ' ').replace(/^./, (c) => c.toUpperCase()), href };
});
---
<Base titulo={p.titulo} descricao={p.resumo || resumir(p.corpo_html)} migalhas={migalhas}>
  <PaginaArtigo p={p} />
</Base>
