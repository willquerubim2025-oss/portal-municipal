---
// Corpo da página do serviço (Carta de Serviços). Usado pela página publicada e pela pré-visualização (D-93).
import { htmlSeguro } from '../lib/html';
import Capa from './vitrine/Capa.astro';
import Videos from './vitrine/Videos.astro';
import ComLateral from './ComLateral.astro';
interface Props { s: any }
const { s } = Astro.props;
const municipioId: string = s.municipio_id;
// Link próprio do serviço: página do portal abre na mesma aba; site externo, em nova aba.
const interno = typeof s.url_externa === 'string' && s.url_externa.startsWith('/');
const blocos: [string, string | null][] = [
  ['Quem pode solicitar', s.publico_alvo],
  ['Prazo', s.prazo],
  ['Custo', s.custo],
  ['Canal de atendimento', s.canal_atendimento],
  ['Local e horário', s.local_horario],
];
---
  <article class="container">
    <header class="cabecalho-pagina">
      <h1>{s.titulo}</h1>
      {s.descricao && <p>{s.descricao}</p>}
    </header>
    <Capa imagem={s.imagem} />
    <Videos videos={s.videos} municipioId={municipioId} />
    <ComLateral>
    <section class="v-bloco v-bloco-ficha" aria-labelledby="t-resumo">
      <h2 id="t-resumo" class="v-bloco-titulo">Informações do serviço</h2>
      <dl class="ficha">
        {blocos.filter(([, v]) => v).map(([r, v]) => <div><dt>{r}</dt><dd>{v}</dd></div>)}
        {s.orgao && <div><dt>Órgão responsável</dt><dd><a href={`/estrutura-organizacional/${s.orgao.slug}`}>{s.orgao.nome}</a>{s.orgao.telefone && ` · ${s.orgao.telefone}`}</dd></div>}
      </dl>
      {s.url_externa && (interno
        ? <p class="v-bloco-acao"><a class="botao" href={s.url_externa}>Acessar</a></p>
        : <p class="v-bloco-acao"><a class="botao" href={s.url_externa} target="_blank" rel="noopener">Acessar o serviço on-line<span class="sr-only"> (abre em nova aba)</span></a></p>)}
    </section>
    {s.requisitos_html && <section class="v-bloco conteudo" aria-labelledby="t-requisitos"><h2 id="t-requisitos" class="v-bloco-titulo">Documentos e requisitos</h2><div set:html={htmlSeguro(s.requisitos_html)} /></section>}
    {s.etapas_html && <section class="v-bloco conteudo v-bloco-passos" aria-labelledby="t-etapas"><h2 id="t-etapas" class="v-bloco-titulo">Como solicitar</h2><div set:html={htmlSeguro(s.etapas_html)} /></section>}
    </ComLateral>
  </article>
