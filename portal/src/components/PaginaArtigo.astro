---
// Corpo da página institucional. Usado pela página publicada e pela pré-visualização (D-93).
import { htmlSeguro } from '../lib/html';
interface Props { p: any }
const { p } = Astro.props;
---
  <article class="container">
    <header class="cabecalho-pagina">
      <h1>{p.titulo}</h1>
      {p.resumo && <p>{p.resumo}</p>}
    </header>
    <div class="conteudo" set:html={htmlSeguro(p.corpo_html)} />
    {p.filhas?.length > 0 && (
      <nav aria-label={`Páginas em ${p.titulo}`}>
        <ul class="lista-simples">
          {p.filhas.map((f: any) => <li><h2><a href={`/${f.caminho}`}>{f.titulo}</a></h2>{f.resumo && <p>{f.resumo}</p>}</li>)}
        </ul>
      </nav>
    )}
  </article>
