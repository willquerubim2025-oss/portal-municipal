---
// Notícias da página inicial (vitrine): a manchete (prioridade 'principal', 0020; sem ela,
// a mais recente) ocupa o espaço maior; as demais ficam ao lado, sempre com foto quando houver.
import { urlImagem, srcsetImagem } from '../../lib/imagens';
import { data } from '../../lib/formato';
interface Props { noticias: any[]; titulo: string }
const { noticias, titulo } = Astro.props;
const indice = Math.max(0, noticias.findIndex((n) => n.prioridade === 'principal'));
const manchete = noticias[indice];
const demais = noticias.filter((_, i) => i !== indice).slice(0, 4);
---
<div class="v-secao-titulo">
  <h2 id="titulo-noticias">{titulo}</h2>
  <a href="/noticias" class="v-link-seta">Todas as notícias</a>
</div>
{!manchete ? <p>Nenhuma notícia publicada ainda.</p> : (
  <div class="v-noticias">
    <article class="v-noticia v-noticia-manchete">
      {manchete.imagem && <img src={urlImagem(manchete.imagem.storage_path, 800)} srcset={srcsetImagem(manchete.imagem.storage_path, [480, 800, 1200])} sizes="(max-width: 900px) 100vw, 60vw" alt={manchete.imagem.texto_alternativo ?? ''} width="800" height="450" decoding="async" />}
      <div class="v-noticia-texto">
        <time datetime={manchete.publicado_em}>{data(manchete.publicado_em)}</time>
        <h3><a href={`/noticias/${manchete.slug}`}>{manchete.titulo}</a></h3>
        {manchete.resumo && <p>{manchete.resumo}</p>}
      </div>
    </article>
    {demais.length > 0 && (
      <div class="v-noticias-lista">
        {demais.map((n) => (
          <article class="v-noticia v-noticia-pequena">
            {n.imagem
              ? <img src={urlImagem(n.imagem.storage_path, 320)} srcset={srcsetImagem(n.imagem.storage_path, [320, 480])} sizes="160px" alt={n.imagem.texto_alternativo ?? ''} width="160" height="120" loading="lazy" decoding="async" />
              : <span class="v-noticia-sem-foto" aria-hidden="true"></span>}
            <div class="v-noticia-texto">
              <time datetime={n.publicado_em}>{data(n.publicado_em)}</time>
              <h3><a href={`/noticias/${n.slug}`}>{n.titulo}</a></h3>
            </div>
          </article>
        ))}
      </div>
    )}
  </div>
)}
