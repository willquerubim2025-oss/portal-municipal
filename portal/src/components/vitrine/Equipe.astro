---
// Equipe gestora (0019): três níveis com cards de tamanhos diferentes; o nível 3 é agrupado
// pela divisão (orgaos). Sem foto autorizada, um avatar com as iniciais (nunca foto de banco).
import { urlImagem } from '../../lib/imagens';
interface Props { pessoas: any[]; titulo: string }
const { pessoas, titulo } = Astro.props;
const nivel = (n: number) => pessoas.filter((p) => p.nivel === n);
const divisoes = new Map<string, any[]>();
for (const p of nivel(3)) {
  const d = p.orgao?.nome ?? 'Divisões';
  divisoes.set(d, [...(divisoes.get(d) ?? []), p]);
}
const iniciais = (nome: string) => nome.split(/\s+/).filter((x) => x.length > 2 || /^[A-ZÁ-Ú]/.test(x)).map((x) => x[0]).slice(0, 2).join('').toUpperCase();
const ROTULOS: Record<number, string> = { 1: 'Direção', 2: 'Supervisão de ensino', 3: 'Divisões e departamentos' };
---
<div class="v-secao-titulo"><h2 id="titulo-equipe">{titulo}</h2></div>
{[1, 2].map((n) => nivel(n).length > 0 && (
  <section class={`v-equipe-nivel v-equipe-${n}`} aria-label={ROTULOS[n]}>
    {n > 1 && <h3 class="v-rotulo">{ROTULOS[n]}</h3>}
    <ul>
      {nivel(n).map((p) => (
        <li class="v-pessoa">
          {p.foto
            ? <img src={urlImagem(p.foto.storage_path, 320)} alt={p.foto.texto_alternativo ?? `Foto de ${p.nome}`} width="160" height="160" loading="lazy" decoding="async" />
            : <span class="v-avatar" aria-hidden="true">{iniciais(p.nome)}</span>}
          <div>
            <p class="v-pessoa-nome">{p.nome}</p>
            <p class="v-pessoa-cargo">{p.cargo}</p>
            {p.email && <p class="v-pessoa-contato"><a href={`mailto:${p.email}`}>{p.email}</a></p>}
            {p.telefone && <p class="v-pessoa-contato">{p.telefone}</p>}
          </div>
        </li>
      ))}
    </ul>
  </section>
))}
{divisoes.size > 0 && (
  <section class="v-equipe-nivel v-equipe-3" aria-label={ROTULOS[3]}>
    <h3 class="v-rotulo">{ROTULOS[3]}</h3>
    <div class="v-divisoes">
      {[...divisoes].map(([divisao, membros]) => (
        <div class="v-divisao">
          <h4>{divisao}</h4>
          <ul>
            {membros.map((p) => (
              <li class="v-pessoa">
                <span class="v-avatar" aria-hidden="true">{iniciais(p.nome)}</span>
                <div><p class="v-pessoa-nome">{p.nome}</p><p class="v-pessoa-cargo">{p.cargo}</p></div>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </section>
)}
