---
// Foto de capa das páginas e dos serviços (D-100, migração 0027). Sem texto alternativo, é decorativa.
import { urlImagem, srcsetImagem } from '../../lib/imagens';
interface Props { imagem?: { storage_path: string; texto_alternativo?: string | null } | null }
const { imagem } = Astro.props;
---
{imagem?.storage_path && (
  <figure class="v-capa">
    <img src={urlImagem(imagem.storage_path, 1600)} srcset={srcsetImagem(imagem.storage_path, [640, 800, 1200, 1600])}
      sizes="(max-width: 1290px) 100vw, 1290px" alt={imagem.texto_alternativo ?? ''} width="1600" height="560" fetchpriority="high" />
  </figure>
)}
