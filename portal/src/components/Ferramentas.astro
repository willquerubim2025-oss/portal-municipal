---
// Ferramentas de acessibilidade (eMAG 3.1): página de acessibilidade, tamanho do texto e alto contraste.
// Na barra clássica aparecem com texto; no cabeçalho único do layout vitrine (compacto) viram botões
// redondos com ícone, mantendo o nome acessível (aria-label) e a dica ao passar o mouse (title).
// O comportamento (data-fonte, #botao-contraste) fica no script do Base.astro.
interface Props { compacto?: boolean }
const { compacto = false } = Astro.props;
const simbolo = (
  `<svg class="simbolo-acessibilidade" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false">
    <circle cx="12" cy="12" r="11" fill="none" stroke="currentColor" stroke-width="1.6" />
    <circle cx="12" cy="6.2" r="1.6" fill="currentColor" />
    <path d="M6.5 9.2l5.5 1 5.5-1M12 10.2v4.2m0 0l-2.6 4.6m2.6-4.6l2.6 4.6" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
  </svg>`
);
---
{compacto ? (
  <ul class="ferramentas v-ferramentas" aria-label="Acessibilidade">
    <li><a href="/acessibilidade" class="v-ferramenta" title="Acessibilidade"><Fragment set:html={simbolo} /><span class="sr-only">Acessibilidade</span></a></li>
    <li><button type="button" class="v-ferramenta" data-fonte="-1" aria-label="Diminuir o tamanho do texto" title="Diminuir o texto">A−</button></li>
    <li><button type="button" class="v-ferramenta" data-fonte="0" aria-label="Tamanho normal do texto" title="Texto normal">A</button></li>
    <li><button type="button" class="v-ferramenta" data-fonte="1" aria-label="Aumentar o tamanho do texto" title="Aumentar o texto">A+</button></li>
    <li>
      <button type="button" class="v-ferramenta" id="botao-contraste" aria-pressed="false" aria-label="Alto contraste" title="Alto contraste">
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="9" fill="none" stroke="currentColor" stroke-width="2"/><path d="M12 3a9 9 0 0 1 0 18z" fill="currentColor"/></svg>
      </button>
    </li>
  </ul>
) : (
  <ul class="ferramentas">
    <li>
      <a href="/acessibilidade" class="link-acessibilidade"><Fragment set:html={simbolo} /> Acessibilidade</a>
    </li>
    <li>
      <span class="tamanho-texto" role="group" aria-label="Tamanho do texto">
        <button type="button" data-fonte="-1" aria-label="Diminuir o tamanho do texto">A-</button>
        <button type="button" data-fonte="0" aria-label="Tamanho normal do texto">A</button>
        <button type="button" data-fonte="1" aria-label="Aumentar o tamanho do texto">A+</button>
      </span>
    </li>
    <li><button type="button" id="botao-contraste" aria-pressed="false">Alto contraste</button></li>
  </ul>
)}
