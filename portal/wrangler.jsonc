{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Produção (padrão). Homologação: env "homologacao" (build com CLOUDFLARE_ENV=homologacao).
  // As chaves abaixo são publicáveis (não são segredo): o RLS do banco só libera conteúdo publicado.
  "name": "portal-municipal",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "enable_ctx_exports"],
  // Cache na borda (D-30): só a entrada Portal guarda respostas; a portaria (default) repassa
  // com o domínio em ctx.props, que entra na chave do cache (o cache não separa por domínio sozinho).
  // Limpeza: segredo CACHE_SEGREDO (wrangler secret put CACHE_SEGREDO [--env homologacao]).
  "cache": { "enabled": true },
  "exports": {
    "default": { "type": "worker", "cache": { "enabled": false } },
    "Portal": { "type": "worker", "cache": { "enabled": true } }
  },
  "observability": { "enabled": true },
  // Redimensionamento de imagens (D-36): /imagem/<largura>/<caminho>.
  "images": { "binding": "IMAGES" },
  "vars": {
    "SUPABASE_URL": "https://qgywucdnaeheqndcxtho.supabase.co",
    "SUPABASE_PUBLISHABLE_KEY": "sb_publishable_5hNTishJduD5ApO7MTuUqQ_lqbfTMOF"
  },
  "env": {
    "homologacao": {
      "name": "portal-municipal-homologacao",
      "images": { "binding": "IMAGES" },
      "vars": {
        "SUPABASE_URL": "https://kvilgamsyneenjtlllcf.supabase.co",
        "SUPABASE_PUBLISHABLE_KEY": "sb_publishable_Be47d2VktOMB_5vhUi8Y7A_oQU9yTsv",
        "PAINEL_URL": "https://painel-municipal-homologacao.willquerubim2025.workers.dev"
      }
    }
  }
}
