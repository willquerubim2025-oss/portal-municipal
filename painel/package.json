{
  "name": "painel-municipal",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "e2e": "node e2e/rodar.mjs",
    "build:homologacao": "tsc --noEmit && vite build --mode homologacao",
    "build:producao": "tsc --noEmit && vite build --mode producao",
    "deploy:homologacao": "npm run build:homologacao && wrangler deploy --env homologacao",
    "deploy:producao": "npm run build:producao && wrangler deploy",
    "e2e:limpar": "node e2e/limpar-homologacao.mjs --aplicar"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.2",
    "@tiptap/extension-image": "^3.31.4",
    "@tiptap/pm": "^3.31.4",
    "@tiptap/react": "^3.31.4",
    "@tiptap/starter-kit": "^3.31.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "playwright": "^1.63.0",
    "typescript": "~6.0",
    "vite": "^8.3.2",
    "wrangler": "^4.147.0"
  }
}
