# Copie para painel/e2e/.env.e2e (fora do git) e preencha. Nunca versionar senhas (D-25).
# Os testes rodam na HOMOLOGAÇÃO, na organização abaixo.
E2E_ORG=paulinia-educacao
E2E_PAINEL=http://localhost:5190
E2E_PORTAL=http://localhost:4321
# Caminho do Chromium, se o Playwright não achar o dele (ex.: /opt/pw-browsers/chromium)
E2E_CHROMIUM=

# Administrador de teste da organização (papel Administrador)
E2E_ADMIN_EMAIL=admin.teste@secke.dev
E2E_ADMIN_SENHA=
# Equipe da SECKE na homologação (chamados, limpeza)
E2E_SECKE_EMAIL=secke.teste@exemplo.gov.br
E2E_SECKE_SENHA=
# Senha das contas criadas por `node e2e/preparar.mjs` (redator e escola); escolha uma
E2E_SENHA_TESTES=
E2E_REDATOR_EMAIL=redator.e2e@secke.dev
E2E_ESCOLA_EMAIL=escola.e2e@secke.dev
# Slug da unidade da conta da escola (vazio = a primeira em ordem alfabética)
E2E_ESCOLA_UNIDADE=
